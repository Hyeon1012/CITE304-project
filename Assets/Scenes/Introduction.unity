--- !u!114 &1676950307
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1676950306}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e4fb223fc8423142a2cda11e8a09eab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Introduction
  introStages:
  - stageImage: {fileID: -2715266225449348505, guid: f6fc7e4df22798c4ea5e91caad98225a, type: 3}
    stageText: "\uC911\uAC04\uACE0\uC0AC, \uACFC\uC81C, \uB7A9 \uBBF8\uD305\uC774
      \uACB9\uCE5C \uC5B4\uB290 \uB0A0 \uBC24, \uBD88\uC30D\uD55C \uC774 \uD559\uC0DD\uC740
      \uBC29\uC5D0\uC11C \uBC24\uC0C8 \uACFC\uC81C\uB97C \uD558\uACE0 \uC788\uC5C8\uB2E4."
    changeImage: 1
  - stageImage: {fileID: 0}
    stageText: "\uADF8\uC758 \uBC29\uC740 \uBE48 \uC5D0\uB108\uC9C0 \uB4DC\uB9C1\uD06C
      \uCE94, \uB9C8\uC2DC\uB358 \uCEE4\uD53C, \uD3B8\uC758\uC810 \uC74C\uC2DD\uB4E4\uACFC
      \uCE58\uC6B0\uC9C0 \uBABB\uD55C \uC4F0\uB808\uAE30\uB4E4\uC774 \uC5BD\uD600
      \uC788\uB2E4."
    changeImage: 0
  - stageImage: {fileID: 0}
    stageText: "\uADF8\uB7F0\uB370 \uC800\uB7F0,\r\n"
    changeImage: 0
  - stageImage: {fileID: 6610002374100930283, guid: 631292a020af4f442acfa6ccd3e11e57, type: 3}
    stageText: "\uACB0\uAD6D \uC5F0\uC774\uC740 \uBC24\uC0D8\uC5D0 \uC878\uC74C\uC744
      \uC774\uAE30\uC9C0 \uBABB\uD558\uACE0 \uCC45\uC0C1\uC5D0 \uC5CE\uB4DC\uB824
      \uC7A0\uB4E4\uC5B4 \uBC84\uB9AC\uACE0 \uB9CC\uB2E4."
    changeImage: 1
  - stageImage: {fileID: 0}
    stageText: "\uC560\uC11D\uD558\uAC8C\uB3C4, \uADF8\uAC00 \uC7A0\uB4E4\uC790\uB9C8\uC790
      \uB178\uD2B8\uBD81\uC740 \uC624\uB958\uB97C \uB744\uC6B4\uB2E4."
    changeImage: 0
  - stageImage: {fileID: 0}
    stageText: "\uADF8\uB54C, \uADF8\uC758 \uBC29\uC744 \uB5A0\uB098 \uB2E4\uB978
      \uACF3\uC73C\uB85C \uB208\uC744 \uB3CC\uB824\uBCF4\uBA74..."
    changeImage: 0
  - stageImage: {fileID: -1656452031169959671, guid: 4f47f6b78c7df4e4fbef3c3637cb18ef, type: 3}
    stageText: "\"\uC624\uB958, \uC624\uB958\""
    changeImage: 1
  - stageImage: {fileID: 0}
    stageText: "\"\uBCF5\uAD6C \uD504\uB85C\uD1A0\uCF5C \uC2E4\uD589 \uC911\""
    changeImage: 0
  - stageImage: {fileID: 0}
    stageText: "\"\uB300\uC0C1 \uC9C0\uC815 \uC644\uB8CC\""
    changeImage: 0
  - stageImage: {fileID: 0}
    stageText: '"Phoenix form... accepted"'
    changeImage: 0
  - stageImage: {fileID: 2063826154672905881, guid: a2ce21c2393d1ff4fbe55713552dd0be, type: 3}
    stageText: "\uC5BC\uB9C8\uB098 \uC9C0\uB0AC\uC744\uAE4C."
    changeImage: 1
  - stageImage: {fileID: 0}
    stageText: "\"\uC73C\uC73C...\uBA38\uB9AC\uC57C. \uAE5C\uBE61 \uC7A0\uB4E0\uAC74\uAC00?\""
    changeImage: 0
  - stageImage: {fileID: 0}
    stageText: "\"\uC7A0\uAE50\uB9CC... \uBAB8\uC774 \uBB54\uAC00 \uC774\uC0C1\uD55C\uB370.\""
    changeImage: 0
  - stageImage: {fileID: -7321662693090332162, guid: 1130b58ac3bfcfd45a1bf8a966acf3eb, type: 3}
    stageText: "\".....\uC774\uAC8C \uBB50\uC57C!!!!\""
    changeImage: 1
  - stageImage: {fileID: 8453818891322547240, guid: 220fd25a6ee448f42b0b85762b5518dc, type: 3}
    stageText: "\"\uC774\uAC74 \uB610 \uBB54\uB370...!!! \uB3C4\uB300\uCCB4 \uBB34\uC2A8
      \uC77C\uC774 \uBC8C\uC5B4\uC9C4\uAC70\uC57C??\""
    changeImage: 1
  targetImage: {fileID: 1812244544}
  targetText: {fileID: 2009889193}
